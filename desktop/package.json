{
  "name": "erp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows client for the ERP web console",
  "main": "main.js",
  "author": "ERP",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.example.erpdesktop",
    "productName": "ERP",
    "files": ["main.js", "offline.html", "config.json"],
    "win": { "target": "portable", "artifactName": "ERP-${version}.exe" }
  }
}
