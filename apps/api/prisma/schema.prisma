generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  isActive     Boolean   @default(true)
  locale       String    @default("ar")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  representative Representative?

  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  nameAr      String
  nameEn      String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique // e.g. "sales:create"
  description String?

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------
// Audit (append-only: enforced by DB trigger in the migration)
// ---------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldData    Json?
  newData    Json?
  reason     String?
  ip         String?
  userAgent  String?
  deviceId   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// Settings & accounting core
// ---------------------------------------------------------------

model Currency {
  code     String  @id // "EGP"
  nameAr   String
  nameEn   String
  symbol   String
  decimals Int     @default(2)
  isBase   Boolean @default(false)
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id        String       @id @default(uuid())
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)

  entries JournalEntry[]

  @@unique([startDate, endDate])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(uuid())
  code          String        @unique
  nameAr        String
  nameEn        String
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  isPostable    Boolean       @default(true) // false for group/header accounts
  isActive      Boolean       @default(true)
  openingDebit  Decimal       @default(0) @db.Decimal(18, 2)
  openingCredit Decimal       @default(0) @db.Decimal(18, 2)
  createdAt     DateTime      @default(now())

  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")
  lines    JournalLine[]

  @@index([parentId])
  @@index([type])
}

enum EntryStatus {
  DRAFT
  POSTED
}

model JournalEntry {
  id             String      @id @default(uuid())
  number         Int         @unique @default(autoincrement())
  entryDate      DateTime    @db.Date
  description    String
  status         EntryStatus @default(DRAFT)
  source         String      @default("MANUAL") // MANUAL | SALES_INVOICE | PURCHASE_INVOICE | ...
  sourceId       String? // id of the originating document
  // Idempotency: one entry per (source, sourceId, kind); prevents duplicate postings.
  idempotencyKey String?     @unique
  reversesId     String?     @unique
  periodId       String
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime    @default(now())

  period   FiscalPeriod  @relation(fields: [periodId], references: [id])
  lines    JournalLine[]
  reverses JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversal JournalEntry? @relation("Reversal")

  @@index([entryDate])
  @@index([source, sourceId])
  @@index([status])
}

model JournalLine {
  id          String  @id @default(uuid())
  entryId     String
  accountId   String
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  description String?
  partyType   String? // CUSTOMER | SUPPLIER (subledger)
  partyId     String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])
  reconciled ReconciledLine?

  @@index([entryId])
  @@index([accountId])
  @@index([partyType, partyId])
}

// ---------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------

model Unit {
  id     String @id @default(uuid())
  code   String @unique
  nameAr String
  nameEn String

  baseProducts Product[]     @relation("ProductBaseUnit")
  productUnits ProductUnit[]
}

model ProductCategory {
  id       String  @id @default(uuid())
  nameAr   String
  nameEn   String
  parentId String?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id             String   @id @default(uuid())
  code           String   @unique
  barcode        String?  @unique
  nameAr         String
  nameEn         String
  imageUrl       String?
  categoryId     String?
  baseUnitId     String
  purchasePrice  Decimal  @default(0) @db.Decimal(18, 4)
  retailPrice    Decimal  @default(0) @db.Decimal(18, 4)
  wholesalePrice Decimal  @default(0) @db.Decimal(18, 4)
  /// Weighted-average cost per base unit, maintained by the stock engine.
  avgCost        Decimal  @default(0) @db.Decimal(18, 4)
  reorderLevel   Decimal  @default(0) @db.Decimal(18, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  baseUnit      Unit             @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  units         ProductUnit[]
  customerPrices CustomerPrice[]
  balances      StockBalance[]
  movements     StockMovement[]
  transferLines StockTransferLine[]
  salesLines    SalesInvoiceLine[]
  purchaseLines PurchaseInvoiceLine[]

  @@index([categoryId])
  @@index([nameAr])
  @@index([nameEn])
}

/// Additional selling/buying units. factor = number of BASE units in one of this unit
/// (carton = 12 boxes x 10 pieces => factor 120 when the base unit is the piece).
model ProductUnit {
  id        String  @id @default(uuid())
  productId String
  unitId    String
  factor    Decimal @db.Decimal(18, 4)
  barcode   String? @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
}

model CustomerPrice {
  id         String  @id @default(uuid())
  customerId String
  productId  String
  price      Decimal @db.Decimal(18, 4)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

// ---------------------------------------------------------------
// Parties
// ---------------------------------------------------------------

model Customer {
  id               String   @id @default(uuid())
  code             String   @unique
  nameAr           String
  nameEn           String?
  phone            String?
  address          String?
  creditLimit      Decimal  @default(0) @db.Decimal(18, 2)
  paymentTermsDays Int      @default(0)
  regionId         String?
  representativeId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  routeId          String?

  region         GeoArea?        @relation(fields: [regionId], references: [id])
  route          Route?          @relation(fields: [routeId], references: [id])
  representative Representative? @relation(fields: [representativeId], references: [id])
  prices CustomerPrice[]
  salesInvoices SalesInvoice[]

  @@index([nameAr])
  @@index([regionId])
  @@index([routeId])
  @@index([representativeId])
}

model Supplier {
  id               String   @id @default(uuid())
  code             String   @unique
  nameAr           String
  nameEn           String?
  phone            String?
  address          String?
  paymentTermsDays Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseInvoices PurchaseInvoice[]

  @@index([nameAr])
}

// ---------------------------------------------------------------
// Warehouses & stock
// ---------------------------------------------------------------

enum WarehouseType {
  MAIN
  BRANCH
  VEHICLE
}

model Warehouse {
  id        String        @id @default(uuid())
  code      String        @unique
  nameAr    String
  nameEn    String
  type      WarehouseType @default(MAIN)
  isActive  Boolean       @default(true)

  balances      StockBalance[]
  movements     StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  salesInvoices SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  vehicle Vehicle?
}

model StockBalance {
  warehouseId String
  productId   String
  /// In BASE units. A CHECK (quantity >= 0) constraint is added by prisma/sql/constraints.sql.
  quantity    Decimal @default(0) @db.Decimal(18, 4)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@id([warehouseId, productId])
  @@index([productId])
}

enum MovementType {
  OPENING
  PURCHASE_IN
  PURCHASE_RETURN_OUT
  SALE_OUT
  SALE_RETURN_IN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

/// Append-only ledger of every quantity change (trigger in immutability.sql).
model StockMovement {
  id             String       @id @default(uuid())
  number         Int          @unique @default(autoincrement())
  type           MovementType
  warehouseId    String
  productId      String
  /// Signed, in base units: positive = in, negative = out.
  quantity       Decimal      @db.Decimal(18, 4)
  unitCost       Decimal      @default(0) @db.Decimal(18, 4)
  movementDate   DateTime     @db.Date
  source         String
  sourceId       String?
  idempotencyKey String?      @unique
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([productId, warehouseId, movementDate])
  @@index([source, sourceId])
}

enum TransferStatus {
  COMPLETED
}

model StockTransfer {
  id              String         @id @default(uuid())
  number          Int            @unique @default(autoincrement())
  fromWarehouseId String
  toWarehouseId   String
  transferDate    DateTime       @db.Date
  status          TransferStatus @default(COMPLETED)
  note            String?
  idempotencyKey  String?        @unique
  createdById     String?
  createdAt       DateTime       @default(now())

  from  Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  to    Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines StockTransferLine[]
}

model StockTransferLine {
  id         String  @id @default(uuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(18, 4) // base units
  unitCost   Decimal @db.Decimal(18, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
}

// ---------------------------------------------------------------
// Sales & purchases
// ---------------------------------------------------------------

enum PaymentKind {
  CASH
  CREDIT
}

enum DocStatus {
  POSTED
  CANCELLED
}

enum SalesDocKind {
  SALE
  RETURN
}

enum PurchaseDocKind {
  PURCHASE
  RETURN
}

enum ReturnCondition {
  GOOD
  DAMAGED
}

model SalesInvoice {
  id                String          @id @default(uuid())
  number            Int             @unique @default(autoincrement())
  kind              SalesDocKind    @default(SALE)
  customerId        String?
  warehouseId       String
  invoiceDate       DateTime        @db.Date
  paymentKind       PaymentKind
  status            DocStatus       @default(POSTED)
  subtotal          Decimal         @db.Decimal(18, 2) // before discount
  discountTotal     Decimal         @default(0) @db.Decimal(18, 2)
  vatTotal          Decimal         @default(0) @db.Decimal(18, 2)
  total             Decimal         @db.Decimal(18, 2)
  costTotal         Decimal         @default(0) @db.Decimal(18, 2)
  originalInvoiceId String?
  condition         ReturnCondition @default(GOOD)
  /// Client-generated operation id: a retried or offline-replayed request creates the document once.
  idempotencyKey    String          @unique
  journalEntryId    String?
  representativeId  String?
  note              String?
  cancelReason      String?
  cancelledAt       DateTime?
  createdById       String?
  createdAt         DateTime        @default(now())

  customer  Customer?  @relation(fields: [customerId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  lines     SalesInvoiceLine[]

  @@index([customerId, invoiceDate])
  @@index([invoiceDate])
  @@index([representativeId, invoiceDate])
  @@index([originalInvoiceId])
}

model SalesInvoiceLine {
  id         String  @id @default(uuid())
  invoiceId  String
  productId  String
  unitId     String?
  enteredQty Decimal @db.Decimal(18, 4)
  baseQty    Decimal @db.Decimal(18, 4)
  unitPrice  Decimal @db.Decimal(18, 4) // per entered unit
  discount   Decimal @default(0) @db.Decimal(18, 2)
  lineNet    Decimal @db.Decimal(18, 2)
  unitCost   Decimal @default(0) @db.Decimal(18, 4) // per base unit, captured at posting

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model PurchaseInvoice {
  id             String          @id @default(uuid())
  number         Int             @unique @default(autoincrement())
  kind           PurchaseDocKind @default(PURCHASE)
  supplierId     String
  warehouseId    String
  invoiceDate    DateTime        @db.Date
  paymentKind    PaymentKind
  status         DocStatus       @default(POSTED)
  subtotal       Decimal         @db.Decimal(18, 2)
  shippingCost   Decimal         @default(0) @db.Decimal(18, 2)
  vatTotal       Decimal         @default(0) @db.Decimal(18, 2)
  total          Decimal         @db.Decimal(18, 2) // owed to supplier (excludes shipping paid to carrier)
  supplierRef    String?
  idempotencyKey String          @unique
  journalEntryId String?
  note           String?
  cancelReason   String?
  cancelledAt    DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     PurchaseInvoiceLine[]

  @@index([supplierId, invoiceDate])
  @@index([invoiceDate])
}

model PurchaseInvoiceLine {
  id         String  @id @default(uuid())
  invoiceId  String
  productId  String
  unitId     String?
  enteredQty Decimal @db.Decimal(18, 4)
  baseQty    Decimal @db.Decimal(18, 4)
  unitPrice  Decimal @db.Decimal(18, 4) // per entered unit
  lineNet    Decimal @db.Decimal(18, 2)
  unitCost   Decimal @default(0) @db.Decimal(18, 4) // landed cost per base unit

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

// ---------------------------------------------------------------
// Treasury, banks, cheques
// ---------------------------------------------------------------

enum FinancialAccountKind {
  CASHBOX
  BANK
}

/// A cash box or bank account. Each one owns a dedicated postable GL account so its balance
/// always comes from posted journal lines.
model FinancialAccount {
  id            String               @id @default(uuid())
  code          String               @unique
  kind          FinancialAccountKind
  nameAr        String
  nameEn        String
  bankName      String?
  accountNumber String?
  glAccountId   String               @unique
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())

  vouchers        Voucher[]       @relation("VoucherFrom")
  incomingTransfers Voucher[]     @relation("VoucherTo")
  cheques         Cheque[]
  reconciliations BankReconciliation[]
  representative  Representative?
}

enum VoucherType {
  RECEIPT
  PAYMENT
  TRANSFER
}

model Voucher {
  id                  String      @id @default(uuid())
  number              Int         @unique @default(autoincrement())
  type                VoucherType
  voucherDate         DateTime    @db.Date
  amount              Decimal     @db.Decimal(18, 2)
  financialAccountId  String
  toFinancialAccountId String?
  partyType           String? // CUSTOMER | SUPPLIER
  partyId             String?
  counterAccountId    String? // GL account for non-party vouchers (expense, other income)
  description         String
  status              DocStatus   @default(POSTED)
  idempotencyKey      String      @unique
  journalEntryId      String?
  representativeId    String?
  vehicleId           String? // set on vehicle operating-expense payments
  expenseCategory     String? // FUEL | MAINTENANCE | LICENSE | INSURANCE | OTHER
  cancelReason        String?
  cancelledAt         DateTime?
  createdById         String?
  createdAt           DateTime    @default(now())

  financialAccount   FinancialAccount  @relation("VoucherFrom", fields: [financialAccountId], references: [id])
  toFinancialAccount FinancialAccount? @relation("VoucherTo", fields: [toFinancialAccountId], references: [id])

  @@index([financialAccountId, voucherDate])
  @@index([partyType, partyId])
  @@index([representativeId, voucherDate])
  @@index([vehicleId, voucherDate])
}

enum ChequeDirection {
  INCOMING
  OUTGOING
}

enum ChequeStatus {
  PENDING
  SETTLED
  BOUNCED
}

model Cheque {
  id                 String          @id @default(uuid())
  direction          ChequeDirection
  chequeNumber       String
  bankName           String
  dueDate            DateTime        @db.Date
  receivedDate       DateTime        @db.Date
  amount             Decimal         @db.Decimal(18, 2)
  partyType          String // CUSTOMER (incoming) | SUPPLIER (outgoing)
  partyId            String
  /// Outgoing: the bank account the cheque is drawn on. Incoming: set when deposited.
  financialAccountId String?
  status             ChequeStatus    @default(PENDING)
  idempotencyKey     String          @unique
  openJournalEntryId String?
  settleJournalEntryId String?
  settledAt          DateTime?
  note               String?
  createdById        String?
  createdAt          DateTime        @default(now())

  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  @@index([direction, status, dueDate])
  @@index([partyType, partyId])
}

model BankReconciliation {
  id                 String   @id @default(uuid())
  financialAccountId String
  statementDate      DateTime @db.Date
  statementBalance   Decimal  @db.Decimal(18, 2)
  createdById        String?
  createdAt          DateTime @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  lines            ReconciledLine[]

  @@index([financialAccountId, statementDate])
}

/// A journal line can be reconciled once (journal lines themselves stay immutable).
model ReconciledLine {
  journalLineId    String @id
  reconciliationId String

  journalLine    JournalLine        @relation(fields: [journalLineId], references: [id])
  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
}

// ---------------------------------------------------------------
// Distribution: geography, routes, vehicles, representatives
// ---------------------------------------------------------------

enum GeoLevel {
  CITY
  REGION
  DISTRICT
}

model GeoArea {
  id        String   @id @default(uuid())
  level     GeoLevel
  parentId  String?
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())

  parent    GeoArea?   @relation("GeoTree", fields: [parentId], references: [id])
  children  GeoArea[]  @relation("GeoTree")
  customers Customer[]
  routes    Route[]

  @@index([parentId])
  @@index([level])
}

model Route {
  id        String  @id @default(uuid())
  code      String  @unique
  nameAr    String
  nameEn    String
  geoAreaId String?
  isActive  Boolean @default(true)

  geoArea         GeoArea?         @relation(fields: [geoAreaId], references: [id])
  customers       Customer[]
  representatives Representative[]
  vehicles        Vehicle[]
}

model Vehicle {
  id              String    @id @default(uuid())
  plateNumber     String    @unique
  model           String
  driverName      String?
  routeId         String?
  licenseExpiry   DateTime? @db.Date
  insuranceExpiry DateTime? @db.Date
  warehouseId     String    @unique
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  route          Route?          @relation(fields: [routeId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  representative Representative?
}

model Representative {
  id                 String   @id @default(uuid())
  code               String   @unique
  nameAr             String
  nameEn             String?
  phone              String?
  userId             String?  @unique
  routeId            String?
  vehicleId          String?  @unique
  /// The representative's cash custody: a cash box whose GL account sits under "Custodies".
  financialAccountId String   @unique
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  user             User?            @relation(fields: [userId], references: [id])
  route            Route?           @relation(fields: [routeId], references: [id])
  vehicle          Vehicle?         @relation(fields: [vehicleId], references: [id])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  customers        Customer[]
  closings         RepClosing[]
  commissionRules  CommissionRule[]
  commissionEntries CommissionEntry[]
}

enum CommissionBasis {
  SALES
  COLLECTIONS
  MARGIN
}

/// Most specific matching rule wins: representative > product > customer > area.
model CommissionRule {
  id               String          @id @default(uuid())
  representativeId String? // null = applies to every representative
  basis            CommissionBasis
  ratePercent      Decimal         @db.Decimal(7, 4)
  productId        String?
  customerId       String?
  geoAreaId        String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())

  representative Representative? @relation(fields: [representativeId], references: [id])

  @@index([basis, isActive])
}

/// One row per commissioned document. sourceKey is unique, so a document is never commissioned twice.
model CommissionEntry {
  id               String    @id @default(uuid())
  representativeId String
  sourceKey        String    @unique // e.g. SALES_INVOICE:<id>, VOUCHER:<id>, REVERSAL:<key>
  sourceType       String
  sourceId         String
  amount           Decimal   @db.Decimal(18, 2) // signed
  closingId        String?
  journalEntryId   String?
  paidAt           DateTime?
  paymentVoucherId String?
  createdAt        DateTime  @default(now())

  representative Representative @relation(fields: [representativeId], references: [id])

  @@index([representativeId, paidAt])
  @@index([sourceType, sourceId])
}

model RepClosing {
  id                   String   @id @default(uuid())
  representativeId     String
  closingDate          DateTime @db.Date
  salesCash            Decimal  @db.Decimal(18, 2)
  salesCredit          Decimal  @db.Decimal(18, 2)
  salesReturns         Decimal  @db.Decimal(18, 2)
  collections          Decimal  @db.Decimal(18, 2)
  openingCash          Decimal  @db.Decimal(18, 2)
  expectedCash         Decimal  @db.Decimal(18, 2)
  declaredCash         Decimal  @db.Decimal(18, 2)
  cashDifference       Decimal  @db.Decimal(18, 2) // declared - expected: negative = shortage
  loadedValue          Decimal  @db.Decimal(18, 2)
  stockDifferenceValue Decimal  @db.Decimal(18, 2) // counted - expected valued at cost: negative = shortage
  commissionTotal      Decimal  @db.Decimal(18, 2)
  /// Mandatory whenever the cash or stock count differs from the system (documented shortage/overage).
  differenceReason     String?
  createdById          String?
  createdAt            DateTime @default(now())

  representative Representative  @relation(fields: [representativeId], references: [id])
  lines          RepClosingLine[]

  @@unique([representativeId, closingDate])
}

model RepClosingLine {
  id           String  @id @default(uuid())
  closingId    String
  productId    String
  openingQty   Decimal @db.Decimal(18, 4)
  loadedQty    Decimal @db.Decimal(18, 4)
  soldQty      Decimal @db.Decimal(18, 4)
  returnedQty  Decimal @db.Decimal(18, 4) // good returns restocked
  damagedQty   Decimal @db.Decimal(18, 4) // damaged returns (never restocked)
  unloadedQty  Decimal @db.Decimal(18, 4) // sent back to the main warehouse
  expectedQty  Decimal @db.Decimal(18, 4)
  countedQty   Decimal @db.Decimal(18, 4)
  differenceQty Decimal @db.Decimal(18, 4)

  closing RepClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)

  @@index([closingId])
}

// ============================================================================
// Phase 9: human resources
// ============================================================================

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdvanceStatus {
  OPEN
  SETTLED
}

enum PayrollStatus {
  POSTED
  PAID
}

model Employee {
  id         String   @id @default(uuid())
  code       String   @unique
  nameAr     String
  nameEn     String?
  jobTitle   String?
  phone      String?
  hireDate   DateTime @db.Date
  baseSalary Decimal  @db.Decimal(18, 2)
  allowance  Decimal  @default(0) @db.Decimal(18, 2)
  isActive   Boolean  @default(true)
  userId     String?  @unique
  createdAt  DateTime @default(now())

  attendance   Attendance[]
  leaves       LeaveRequest[]
  advances     EmployeeAdvance[]
  payrollLines PayrollLine[]
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  checkIn    DateTime?
  checkOut   DateTime?
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String
  type        LeaveType
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  days        Int
  status      LeaveStatus @default(PENDING)
  reason      String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, fromDate])
}

model EmployeeAdvance {
  id               String        @id @default(uuid())
  employeeId       String
  amount           Decimal       @db.Decimal(18, 2)
  repaid           Decimal       @default(0) @db.Decimal(18, 2)
  monthlyDeduction Decimal       @db.Decimal(18, 2)
  advanceDate      DateTime      @db.Date
  status           AdvanceStatus @default(OPEN)
  voucherId        String?       @unique
  idempotencyKey   String        @unique
  note             String?
  createdById      String?
  createdAt        DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

model PayrollRun {
  id               String        @id @default(uuid())
  /// "YYYY-MM"; one run per month.
  period           String        @unique
  status           PayrollStatus @default(POSTED)
  totalGross       Decimal       @db.Decimal(18, 2)
  totalDeductions  Decimal       @db.Decimal(18, 2)
  totalNet         Decimal       @db.Decimal(18, 2)
  journalEntryId   String?
  paymentVoucherId String?
  createdById      String?
  createdAt        DateTime      @default(now())

  lines PayrollLine[]
}

model PayrollLine {
  id               String  @id @default(uuid())
  runId            String
  employeeId       String
  baseSalary       Decimal @db.Decimal(18, 2)
  allowance        Decimal @db.Decimal(18, 2)
  absentDays       Int
  absenceDeduction Decimal @db.Decimal(18, 2)
  advanceDeduction Decimal @db.Decimal(18, 2)
  netPay           Decimal @db.Decimal(18, 2)

  run      PayrollRun @relation(fields: [runId], references: [id])
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
}

// ============================================================================
// Phase 10: offline synchronisation
// ============================================================================

enum SyncStatus {
  APPLIED
  REJECTED
}

/// One row per operation a device has pushed. The client-generated opId is the idempotency key.
model SyncOperation {
  id              String     @id @default(uuid())
  opId            String     @unique
  userId          String
  deviceId        String
  type            String
  status          SyncStatus
  payload         Json
  resultId        String?
  error           String?
  clientCreatedAt DateTime
  receivedAt      DateTime   @default(now())

  @@index([userId, receivedAt])
}
