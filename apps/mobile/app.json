{
  "expo": {
    "name": "ERP Field",
    "slug": "erp-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "supportsRtl": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.erpfield"
    },
    "android": {
      "package": "com.example.erpfield",
      "versionCode": 1
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "https://erp-api-mw0w.onrender.com/api/v1"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
