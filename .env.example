# Database
DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5432/erp?schema=public
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=erp

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Auth (generate long random values; never commit real ones)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed (initial system admin; used only by db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# Business defaults
DEFAULT_CURRENCY=EGP
DEFAULT_LOCALE=ar
VAT_ENABLED=false
VAT_RATE=0.14
