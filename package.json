{
  "name": "erp-system",
  "private": true,
  "version": "0.1.0",
  "description": "ERP for distribution companies: accounting, inventory, sales, purchases, representatives, vehicles",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "npm run prisma:migrate --workspace @erp/api",
    "db:seed": "npm run prisma:seed --workspace @erp/api",
    "dev:api": "npm run start:dev --workspace @erp/api"
  }
}
